# DhanHQ Market Data API Credentials (Server-Side Only)
# Never commit real credentials to Git.
# Generate your personal Web Access Token from https://dhanhq.co -> Profile -> Access Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Groww Trading & Market API Credentials (Server-Side Only)
# Never commit real credentials to Git.
GROWW_API_KEY=
GROWW_API_SECRET=

# Real OTP Delivery Providers (Server-Side Only)
# Email Providers supported: RESEND, SENDGRID, MOCK
EMAIL_OTP_PROVIDER=
EMAIL_OTP_API_KEY=
EMAIL_OTP_FROM=

# SMS Providers supported: TWILIO, MSG91, FAST2SMS, MOCK
SMS_OTP_PROVIDER=
SMS_OTP_API_KEY=

# Twilio Credentials (when SMS_OTP_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# MSG91 Credentials / DLT Configuration (when SMS_OTP_PROVIDER=MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

