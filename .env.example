# DhanHQ Market Data API Credentials (Server-Side Only)
# Never commit real credentials to Git.
# Generate your personal Web Access Token from https://dhanhq.co -> Profile -> Access Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Groww Trading & Market API Credentials (Server-Side Only)
# Never commit real credentials to Git.
GROWW_API_KEY=
GROWW_API_SECRET=

# Real OTP Delivery Providers (Server-Side Only)
# Email Providers supported: RESEND, SENDGRID, MOCK
EMAIL_OTP_PROVIDER=
EMAIL_OTP_API_KEY=
EMAIL_OTP_FROM=

# SMS Providers supported: FIREBASE, TWILIO, MOCK
SMS_OTP_PROVIDER=firebase

# Google Firebase Phone Authentication (Web SDK & Cloud Identity Platform)
# Create a Firebase Project -> Project Settings -> General -> Your apps -> Web app
# Enable Authentication -> Sign-in method -> Phone
# Configure SMS Regions (Authentication -> Settings -> SMS Regions -> allow India +91)
# Note: Production carrier delivery in India requires Firebase Blaze (Pay as you go) plan
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Twilio Credentials (when SMS_OTP_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

